{
  "name": "@payroll/documents",
  "version": "1.26.0",
  "private": true,
  "description": "Payslip PDF renderer (spec documents): pdfmake, renders EXCLUSIVELY from the frozen run_snapshot. Pure, no I/O beyond Buffer output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@payroll/engine": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pdfmake": "~0.3.7"
  },
  "devDependencies": {
    "@types/node": "~26.6.1",
    "typescript": "~5.9.3"
  }
}
