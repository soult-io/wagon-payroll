{
  "name": "@payroll/verify-site",
  "version": "1.22.0",
  "private": true,
  "description": "Static, PII-free QA verification dashboard generated from the verify-summary history (spec 17, chunk B / PAY-44).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "generate": "tsx src/generate.ts"
  },
  "dependencies": {
    "@payroll/verify-summary": "workspace:*",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "~26.6.1",
    "tsx": "~4.23.13",
    "typescript": "~5.9.3",
    "vitest": "~5.0.1"
  }
}
