# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env & secrets — .env is NOT committed (spec 13: the app repo carries zero
# personal config; deploy env lives in the stack repo / the consumer's host).
# Only the template stays tracked.
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.vitest/

# E2E (hardening B) — Playwright artifacts + boot-fixture state
e2e/.state/
e2e/test-results/
e2e/test-results-walkthrough/
e2e/playwright-report/
e2e/playwright-results.json

# Verify summary (spec 17) — generated reporter json + assembled summary
verify-artifacts/
_reporters/

# Local data (dev postgres etc.)
pgdata/
.claude/

# pay-verify-site workflow scratch (spec 17 chunk B)
_data/
_incoming/

# Mutation testing (PAY-93) — Stryker sandbox + reports
.stryker-tmp*/
reports/
