{
  "name": "payroll",
  "private": true,
  "version": "1.30.1",
  "description": "Wagon Payroll webapp \u2014 stable, deterministic payroll for small business.",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check",
    "e2e": "pnpm -r run build && pnpm --filter @payroll/e2e e2e",
    "mutation:engine": "pnpm --filter @payroll/engine exec stryker run",
    "mutation:server-deposits": "pnpm --filter \"@payroll/server^...\" run build && pnpm --filter @payroll/server exec stryker run stryker.deposits.config.mjs",
    "mutation:server-filings": "pnpm --filter \"@payroll/server^...\" run build && pnpm --filter @payroll/server exec stryker run stryker.filings.config.mjs",
    "check:mutation-globs": "node scripts/check-mutation-test-globs.mjs",
    "check:workflow-runners": "node --test scripts/check-workflow-runners.test.mjs && node scripts/check-workflow-runners.mjs",
    "test:clock-shift": "node --test scripts/clock-shift.test.mjs",
    "format": "biome format --write",
    "db:generate": "pnpm --filter @payroll/db run generate",
    "db:migrate": "pnpm --filter @payroll/db run migrate",
    "migrate:legacy": "pnpm --filter @payroll/server run migrate:legacy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "yaml": "2.9.0"
  }
}
